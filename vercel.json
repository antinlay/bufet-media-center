{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "env": {
    "EXPO_PUBLIC_API_URL": "https://bufet-media-api.onrender.com"
  },
  "installCommand": "npx --yes pnpm@9.12.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.12.0 --filter @bufet/shared build && npx --yes pnpm@9.12.0 --filter @bufet/dashboard build:web",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
