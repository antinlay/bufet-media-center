{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "apk": {
      "node": "20.17.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ALLOW_HTTP": "0",
        "PNPM_VERSION": "9.12.0",
        "YARN_IGNORE_PACKAGE_MANAGER": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
