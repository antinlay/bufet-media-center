{
  "expo": {
    "name": "BUFET Dashboard",
    "slug": "bufet-dashboard",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "bufetdash",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Нужен доступ к камере для QR-кодов. Camera access is required to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-router",
      "expo-image"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    },
    "ios": {
      "bundleIdentifier": "com.lyabowski.bufet-dashboard"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0B0D"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e435a0aa-463d-429f-9ce2-4c97b2ba7185"
      }
    }
  }
}
