{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openaiDeveloperDocs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true
    },
    "appledeepdoc": {
      "type": "local",
      "command": ["/Users/janiecee/.codex/appledeepdoc-mcp/run.sh"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "xcode": {
      "type": "local",
      "command": ["xcrun", "mcpbridge"],
      "enabled": true
    }
  }
}
