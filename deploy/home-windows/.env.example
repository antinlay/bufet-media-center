# Domains must point to the Windows host's public IP.
API_DOMAIN=bufet-api.duckdns.org
DASHBOARD_DOMAIN=bufet-dashboard.duckdns.org
# Use a real email address for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Required Rails secret. Generate a new value; do not reuse this example.
SECRET_KEY_BASE=

# PostgreSQL (keep DATABASE_URL in sync with these values).
POSTGRES_DB=bufet_production
POSTGRES_USER=bufet
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://bufet:change-this-password@postgres:5432/bufet_production

# Used to generate pairing URLs that open the dashboard /pair screen.
CONCERTO_DASHBOARD_URL=https://bufet-dashboard.duckdns.org
CONCERTO_ALLOWED_ORIGINS=https://bufet-dashboard.duckdns.org

# Expo reads this at build time and bakes it into the web dashboard image.
EXPO_PUBLIC_API_URL=https://bufet-api.duckdns.org

# Optional: allow plain HTTP mode behind the proxy (not recommended for internet).
# If set, Rails will not force SSL.
# DISABLE_SSL=1
